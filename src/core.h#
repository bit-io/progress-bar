;; [WAŻNE] Moduły spoza core.h# (bar.h#, template.h#, spinner.h#, eta.h#...)
;; NIE czytają `.total`/`.current`/... bezpośrednio z wartości typu
;; `ProgressState` — czytają przez te funkcje. To dokładnie ten sam wzorzec
;; co `reg_name`/`reg_git` w bit/src/registry.h# i `member_success`/
;; `member_bin_path` w bit/src/progress.h#: odczyt pola structa
;; zadeklarowanego w INNYM module bywa (w tej wersji interpretera H#)
;; rozwiązywany przez dopasowanie nazwy pola po wszystkich znanych
;; structach zamiast po zadeklarowanym typie — co psuje się, gdy dwa
;; structy w różnych modułach mają pole o tej samej nazwie (tu akurat
;; `ProgressState.width` i `style::ProgressStyle.width` kolidują).
;; Akcesor w TYM SAMYM module co struct zawsze trafia we właściwe pole.
pub fn state_total(s: ProgressState)      -> int    is return s.total end
pub fn state_current(s: ProgressState)    -> int    is return s.current end
pub fn state_width(s: ProgressState)      -> int    is return s.width end
pub fn state_label(s: ProgressState)      -> string is return s.label end
pub fn state_message(s: ProgressState)    -> string is return s.message end
pub fn state_started_at(s: ProgressState) -> int    is return s.started_at end
pub fn state_finished(s: ProgressState)   -> bool   is return s.finished end
pub fn state_tick_count(s: ProgressState) -> int    is return s.tick end
